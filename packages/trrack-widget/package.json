{
  "name": "trrack-controls",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild js/controls.tsx js/persisted.ts --bundle --format=esm --minify --alias:react=preact/compat --alias:react-dom=preact/compat --alias:react/jsx-runtime=preact/jsx-runtime --outdir=src/trrack_widget/static",
    "dev": "esbuild js/controls.tsx js/persisted.ts --bundle --format=esm --sourcemap=inline --watch --alias:react=preact/compat --alias:react-dom=preact/compat --alias:react/jsx-runtime=preact/jsx-runtime --outdir=src/trrack_widget/static",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint js",
    "format": "oxfmt --write js",
    "format:check": "oxfmt --check js"
  },
  "dependencies": {
    "@anywidget/react": "^0.2.2",
    "lucide-react": "^1.73.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@anywidget/types": "^0.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
